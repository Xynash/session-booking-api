# Runtime
NODE_ENV=development
PORT=3000

# Database (use a MongoDB Atlas SRV string or a local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/session_booking

# Security
# Comma-separated list of allowed browser origins. Use * only for local development.
CORS_ORIGIN=*
# Set to the number of reverse proxies in front of the app (0 = none) so rate limiting sees the real client IP
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
