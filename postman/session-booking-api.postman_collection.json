{
  "info": {
    "name": "Session Booking API",
    "description": "Generated from the route registry by `npm run postman` (do not edit by hand). Run the \"Happy path\" folder top to bottom, then \"Negative cases\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "dateTimestamp",
      "value": ""
    },
    {
      "key": "startTime",
      "value": ""
    },
    {
      "key": "endTime",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Builds a fresh, valid time slot (tomorrow 10:00-11:00 UTC) so the collection runs on any day.",
          "const d = new Date();",
          "const dayStart = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() + 1);",
          "pm.collectionVariables.set('dateTimestamp', String(dayStart));",
          "pm.collectionVariables.set('startTime', new Date(dayStart + 10 * 3600 * 1000).toISOString());",
          "pm.collectionVariables.set('endTime', new Date(dayStart + 11 * 3600 * 1000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Create Teacher (helper)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.collectionVariables.set('teacherId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Verma\",\n  \"email\": \"asha.{{$timestamp}}{{$randomInt}}@example.com\",\n  \"specialization\": \"Mathematics\",\n  \"experience\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teachers"
              ]
            },
            "description": "POST /teachers\n\nHelper endpoint (not in the assignment spec) so the API can be exercised without touching the database."
          }
        },
        {
          "name": "API 1 - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.collectionVariables.set('userId', pm.response.json().data._id);",
                  "pm.collectionVariables.set('userEmail', pm.response.json().data.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rohan Mehta\",\n  \"email\": \"rohan.{{$timestamp}}{{$randomInt}}@example.com\",\n  \"phone\": \"+91 98765 43210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "POST /users\n\nCreate a new user. Email must be unique."
          }
        },
        {
          "name": "API 2 - Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.collectionVariables.set('sessionId', pm.response.json().data._id);",
                  "pm.test('Session starts AVAILABLE', () => pm.expect(pm.response.json().data.status).to.eql('AVAILABLE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": "POST /sessions\n\nCreate an AVAILABLE session for an existing teacher. endTime must be greater than startTime."
          }
        },
        {
          "name": "API 3 - Available Sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.test('Created session is listed', () => pm.expect(pm.response.json().data.map(s => s._id)).to.include(pm.collectionVariables.get('sessionId')));",
                  "pm.test('Teacher is embedded', () => pm.expect(pm.response.json().data[0].teacher).to.have.property('fullName'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                }
              ]
            },
            "description": "GET /sessions/available\n\nAll AVAILABLE sessions on the (UTC) day of dateTimestamp. Implemented with an aggregation pipeline."
          }
        },
        {
          "name": "API 4 - Book Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.test('Session is BOOKED for the user', () => { const s = pm.response.json().data; pm.expect(s.status).to.eql('BOOKED'); pm.expect(s.userId).to.eql(pm.collectionVariables.get('userId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "book"
              ]
            },
            "description": "POST /sessions/:id/book\n\nAtomically book an AVAILABLE session for an existing user."
          }
        },
        {
          "name": "API 5 - Mark Session Complete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.test('Session is COMPLETED with completedAt', () => { const s = pm.response.json().data; pm.expect(s.status).to.eql('COMPLETED'); pm.expect(s.completedAt).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}",
                "complete"
              ]
            },
            "description": "PATCH /sessions/:id/complete\n\nMark a BOOKED session as COMPLETED and stamp completedAt."
          }
        },
        {
          "name": "API 6 - User Session List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope is successful', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('X-Request-Id header is present', () => pm.response.to.have.header('X-Request-Id'));",
                  "pm.test('Session appears under completedSessions', () => pm.expect(pm.response.json().data.completedSessions.map(s => s._id)).to.include(pm.collectionVariables.get('sessionId')));",
                  "pm.test('upcomingSessions is empty', () => pm.expect(pm.response.json().data.upcomingSessions).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "sessions"
              ]
            },
            "description": "GET /users/:id/sessions\n\nA user's sessions split into upcomingSessions (BOOKED) and completedSessions. Implemented with an aggregation pipeline ($facet)."
          }
        }
      ]
