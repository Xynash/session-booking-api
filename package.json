{
  "name": "session-booking-api",
  "version": "1.0.0",
  "description": "REST API for booking sessions with teachers (Node.js, TypeScript, Express, MongoDB, Mongoose)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "postman": "tsx scripts/generate-postman.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  }
}
